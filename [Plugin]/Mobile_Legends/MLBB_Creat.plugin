[Rule]

[MITM]
hostname = akmpicture.youngjoygame.com

[Rewrite]

#10以上开头的五位数服务器id
^https:\/\/akmpicture\.youngjoygame\.com\/dist\/face\/1\d{4}\/\d{1,2}\/\d{1,2}\/(\d{6,10}_)?\d{1,3}(_new_[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12})?\.jpg$ - redirect(302, "https://raw.githubusercontent.com/Sign-in-or-Sign-up/MLBB/main/face/1_.jpg")

